# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/chat_app?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/chat_app?retryWrites=true&w=majority
MONGODB_DATABASE=chat_app

